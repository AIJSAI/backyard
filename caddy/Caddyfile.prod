# Production Caddyfile: HTTPS for $BACKYARD_DOMAIN with an automatically-fetched
# Let's Encrypt certificate (auto_https is on by default when a domain block exists).
# Used by docker-compose.prod.yml, which publishes Caddy on 0.0.0.0:80/443. The local
# Caddyfile (plain HTTP on :8000, loopback) is unchanged for the clean-machine repro.
#
# Do NOT add `header Referrer-Policy no-referrer` here. The app sets Referrer-Policy per
# surface (same-origin floor + no-referrer on /t/ /d/); a global no-referrer at the edge
# makes browsers send Origin: null on same-origin form POSTs and Django's CSRF rejects
# them, silently breaking every form in a real browser.
#
# Do NOT add a `log` directive here: request lines carry bearer tokens in their paths
# (/d/, /join/, /media/, /digest/*, /break-glass/ — threat model TS-EDGE-LOG).

{
	admin off
	email {$ACME_EMAIL}
	# TS-CA-6: without these, a slow-header (slowloris) connection is never closed, and slow
	# request bodies stream straight to three synchronous gunicorn workers and pin them for an
	# unbounded window. The row's own acceptance criterion -- "a connection that sends no
	# headers is closed within about ten seconds" -- was failing on the internet-facing file.
	#
	# `write` is deliberately left unset: a small write timeout would cut off legitimately slow
	# elder-video and export downloads, which is the trade TS-CA-6 already reasoned through.
	servers {
		timeouts {
			read_header 10s
			read_body 5m
		}
	}
}

# A request whose Host does not match the site block above falls through to here. Without
# this it was answered by Caddy's implicit fallback: an empty 200 carrying a bare
# `Server: Caddy` and NONE of the headers below -- so the one response that skipped every
# security header was also the one that advertised what was serving it. It reaches no
# application content (measured: 0 bytes on /, /healthz and /accounts/login/ alike), so this
# is fingerprinting rather than a bypass, and `abort` closes the connection without a reply.
:443 {
	tls {$ACME_EMAIL}
	abort
}

{$BACKYARD_DOMAIN} {
	reverse_proxy web:8000
	# 65KB per anonymous page, uncompressed, on every hit -- and no `encode` at all, so a
	# client offering gzip got none. Worst on the elder path, which is the surface most
	# likely to be read over a slow phone connection. zstd first, gzip for everything older.
	encode zstd gzip
	# Hard edge ceiling on the request body (TS-CA-4): rejects an oversized or many-file
	# POST with a 413 before the multipart parser writes temp files, above the largest
	# legitimate post (4 clips at 100MB + photos). The per-file app caps are the fine control.
	request_body {
		max_size 512MB
	}
	# The app owns Referrer-Policy per surface (see the caution above); only nosniff is
	# asserted at the edge as defense in depth, and the Server header is stripped.
	header {
		X-Content-Type-Options nosniff
		-Server
		# `-Server` was stripped for fingerprinting reasons and then Caddy re-announced
		# itself in `Via: 1.1 Caddy` on every response, which gave back exactly what the
		# line above removes.
		-Via
	}

	# Django's build manifest, mapping every asset to its hashed name. Not a secret, but an
	# inventory of the deployed static tree handed to anyone who asks, at a predictable path.
	# Nothing needs it over HTTP: CompressedManifestStaticFilesStorage reads it from disk
	# inside the process. Blocked at the edge because that is where it is reachable.
	handle /static/staticfiles.json {
		respond 404
	}

	# The RFC 9116 disclosure address. Served from the edge rather than Django so it stays
	# reachable when the app is down -- which is when someone most needs to reach a human.
	# Points at GitHub private vulnerability reporting, which is the channel SECURITY.md
	# names and which was disabled until 2026-08-01.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `Contact: https://github.com/AIJSAI/backyard/security/advisories/new
Policy: https://github.com/AIJSAI/backyard/blob/main/SECURITY.md
Preferred-Languages: en
Canonical: https://{$BACKYARD_DOMAIN}/.well-known/security.txt
Expires: 2027-08-01T00:00:00.000Z
` 200
	}
}
